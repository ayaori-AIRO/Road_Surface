# Local SDK/NuGet caches used for build verification.
/.dotnet-local/
/.nuget-local/

# Generated Python bytecode.
__pycache__/
*.py[cod]
/.venv-pi/
/.pnpm-store/

# Keep prediction output directory, but exclude generated contents.
/ML/dataset/predict_noise_snow/*
!/ML/dataset/predict_noise_snow/.gitkeep
